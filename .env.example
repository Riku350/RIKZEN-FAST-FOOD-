# GEMINI_API_KEY: Required for server-side Gemini natural Indian female voice announcements.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ORDER_SIGNING_SECRET: Server-only 64-char hex cryptographic secret (never VITE_ prefixed).
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_SIGNING_SECRET=""

# ORDER_SIGNING_SECRET_PREVIOUS: Optional previous secret kept temporarily during zero-downtime key rotation.
ORDER_SIGNING_SECRET_PREVIOUS=""

# VITE_API_BASE_URL: Optional backend origin if hosting static frontend separately from server.ts.
VITE_API_BASE_URL=""
