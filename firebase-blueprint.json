{
  "entities": {
    "User": {
      "title": "User",
      "description": "Owner or staff account profile for RikZen Fast Food.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "display_name": {
          "type": "string",
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["owner", "staff"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "display_name", "role", "created_at", "updated_at"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Trusted admin allowlist document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "created_at"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Food or beverage item offered on the RikZen Fast Food menu with regular and optional offer price.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "enum": [
            "rolls",
            "burgers",
            "snacks",
            "chicken",
            "fast_food",
            "drinks",
            "lassi",
            "desserts",
            "special"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 4,
          "maxLength": 220
        },
        "price": {
          "type": "number"
        },
        "offer_price": {
          "type": "number"
        },
        "image": {
          "type": "string",
          "maxLength": 500
        },
        "available": {
          "type": "boolean"
        },
        "is_veg": {
          "type": "boolean"
        },
        "featured": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "description",
        "price",
        "offer_price",
        "image",
        "available",
        "is_veg",
        "featured",
        "created_at",
        "updated_at"
      ]
    },
    "Offer": {
      "title": "Offer",
      "description": "Promotional combo or special discount offer managed by the shop owner.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 4,
          "maxLength": 200
        },
        "image": {
          "type": "string",
          "maxLength": 500
        },
        "regular_price": {
          "type": "number"
        },
        "offer_price": {
          "type": "number"
        },
        "active": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "image",
        "regular_price",
        "offer_price",
        "active",
        "created_at",
        "updated_at"
      ]
    },
    "Table": {
      "title": "Table",
      "description": "One of the 6 physical dining tables in RikZen Fast Food.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["table_1", "table_2", "table_3", "table_4", "table_5", "table_6"]
        },
        "table_number": {
          "type": "number"
        },
        "qr_code": {
          "type": "string",
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "enum": ["available", "ordering", "preparing", "ready", "bill_requested"]
        },
        "active_order_id": {
          "type": "string",
          "maxLength": 128
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "table_number", "qr_code", "status", "active_order_id", "updated_at"]
    },
    "Order": {
      "title": "Order",
      "description": "Real-time dine-in customer order with customer details, server-calculated discount, PDF bill, and WhatsApp delivery status.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "order_number": {
          "type": "number"
        },
        "order_code": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^RK[0-9]{4,8}$"
        },
        "table_id": {
          "type": "string",
          "enum": ["table_1", "table_2", "table_3", "table_4", "table_5", "table_6"]
        },
        "table_number": {
          "type": "number"
        },
        "customer_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "customer_mobile": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^\\+91[6-9][0-9]{9}$"
        },
        "items": {
          "type": "array"
        },
        "item_count": {
          "type": "number"
        },
        "subtotal": {
          "type": "number"
        },
        "discount": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "accepted",
            "confirmed",
            "preparing",
            "ready",
            "bill_requested",
            "bill_ready",
            "completed",
            "rejected",
            "cancelled"
          ]
        },
        "payment_status": {
          "type": "string",
          "enum": ["not_paid", "pending", "verification_requested", "paid", "not_received", "failed"]
        },
        "paid_at": {
          "type": "string",
          "maxLength": 64
        },
        "payment_verified_by": {
          "type": "string",
          "maxLength": 128
        },
        "payment_verified_at": {
          "type": "string",
          "maxLength": 64
        },
        "confirmed_at": {
          "type": "string",
          "maxLength": 64
        },
        "cancelled_at": {
          "type": "string",
          "maxLength": 64
        },
        "cancelled_by": {
          "type": "string",
          "maxLength": 128
        },
        "upi_uri": {
          "type": "string",
          "maxLength": 500
        },
        "public_bill_id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "payment_qr_snapshot": {
          "type": "object"
        },
        "pdf_ready": {
          "type": "boolean"
        },
        "bill_status": {
          "type": "string",
          "enum": [
            "not_generated",
            "generating",
            "generated",
            "sending",
            "sent",
            "failed",
            "retrying"
          ]
        },
        "pdf_url": {
          "type": "string",
          "maxLength": 400
        },
        "pdf_path": {
          "type": "string",
          "maxLength": 240
        },
        "generated_at": {
          "type": "string",
          "maxLength": 64
        },
        "sent_at": {
          "type": "string",
          "maxLength": 64
        },
        "send_status": {
          "type": "string",
          "enum": ["not_sent", "sending", "retrying", "sent", "failed"]
        },
        "whatsapp_status": {
          "type": "string",
          "enum": ["not_sent", "sending", "retrying", "sent", "failed"]
        },
        "whatsapp_error": {
          "type": "string",
          "maxLength": 240
        },
        "customer_session_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "server_signature": {
          "type": "string",
          "minLength": 32,
          "maxLength": 128,
          "pattern": "^[a-fA-F0-9]+$"
        },
        "notes": {
          "type": "string",
          "maxLength": 200
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "order_number",
        "order_code",
        "table_id",
        "table_number",
        "customer_name",
        "customer_mobile",
        "items",
        "item_count",
        "subtotal",
        "discount",
        "total",
        "status",
        "pdf_ready",
        "bill_status",
        "pdf_url",
        "pdf_path",
        "generated_at",
        "customer_session_id",
        "server_signature",
        "notes",
        "created_at",
        "updated_at"
      ]
    },
    "PaymentSettings": {
      "title": "PaymentSettings",
      "description": "Public restaurant payment QR settings (Uploaded QR or Dynamic UPI QR) configured by the shop owner with zero secret credentials.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["payment"]
        },
        "payment_mode": {
          "type": "string",
          "enum": ["uploaded_qr", "dynamic_upi"]
        },
        "upi_id": {
          "type": "string",
          "maxLength": 120
        },
        "merchant_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "qr_image_url": {
          "type": "string",
          "maxLength": 500
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "payment_mode", "upi_id", "merchant_name", "qr_image_url", "updated_at"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Owner and staff profile records with strict PII isolation."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Trusted owner/admin registry keyed by Firebase Auth UID."
    },
    "/menu_items/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Publicly readable menu catalog with regular and offer pricing, writable only by the owner."
    },
    "/offers/{offerId}": {
      "schema": { "$ref": "#/entities/Offer" },
      "description": "Special combo offers created and toggled by the owner."
    },
    "/tables/{tableId}": {
      "schema": { "$ref": "#/entities/Table" },
      "description": "Six physical restaurant tables (table_1 through table_6) managed by the owner."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Live dine-in customer orders including private customer name and +91 mobile. Only the owner may list orders."
    },
    "/shop_settings/{settingId}": {
      "schema": { "$ref": "#/entities/PaymentSettings" },
      "description": "Public restaurant UPI payment settings (id='payment') readable by customers for bill QR display and writable strictly by the verified owner."
    }
  }
}
