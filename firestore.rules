rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Hardened Global Helpers & Authoritative Owner Role
    // =========================================================================

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOrderDocId(id) {
      return id is string && id.size() >= 24 && id.size() <= 128 && id.matches('^ord_[a-zA-Z0-9_\\-]+$');
    }

    function isSafeImageUrl(url) {
      return url is string && url.size() >= 1 && url.size() <= 500 &&
        (url.matches('^/src/assets/.*') || url.matches('^/assets/.*') || url.matches('^/uploads/.*') || url.matches('^https://.*'));
    }

    function isSafeBillUrl(url) {
      return url is string && url.size() <= 400 &&
        (url == '' || url.matches('^/api/bills/file/ord_[a-zA-Z0-9_\\-]+/RikZen-Fast-Food-Bill-RK[0-9]{4,8}\\.pdf\\?sig=[a-fA-F0-9]{64}$'));
    }

    function isSafeBillPath(p) {
      return p is string && p.size() <= 240 &&
        (p == '' || p.matches('^/bills/ord_[a-zA-Z0-9_\\-]+/RikZen-Fast-Food-Bill-RK[0-9]{4,8}\\.pdf$'));
    }

    function isSafeUpiUri(uri) {
      return uri is string && uri.size() <= 500 &&
        (uri == '' || uri.matches('^upi://pay\\?.*$'));
    }

    function isValidPaymentQrSnapshot(snap) {
      return snap is map &&
        snap.keys().hasAll(['mode', 'merchant_name', 'upi_id', 'qr_image_url', 'upi_uri', 'captured_at']) &&
        snap.keys().hasOnly(['mode', 'merchant_name', 'upi_id', 'qr_image_url', 'upi_uri', 'captured_at']) &&
        snap.mode in ['uploaded_qr', 'dynamic_upi'] &&
        snap.merchant_name is string && snap.merchant_name.size() <= 80 &&
        snap.upi_id is string && snap.upi_id.size() <= 120 &&
        snap.qr_image_url is string && snap.qr_image_url.size() <= 500 &&
        (snap.qr_image_url == '' || isSafeImageUrl(snap.qr_image_url)) &&
        isSafeUpiUri(snap.upi_uri) &&
        snap.captured_at is string && snap.captured_at.size() <= 64;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Single authoritative owner/admin check verified independently by Firestore
    function isOwner() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'owner' ||
        (request.auth.token.email is string && request.auth.token.email.lower() == 'rikudatabackup@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner')
      );
    }

    // =========================================================================
    // Entity Validation Blueprints (Anti-Update-Gap)
    // =========================================================================

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'display_name', 'role', 'created_at', 'updated_at']) &&
        data.keys().hasOnly(['uid', 'email', 'display_name', 'role', 'created_at', 'updated_at']) &&
        data.uid is string && data.uid == userId && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.display_name is string && data.display_name.size() >= 1 && data.display_name.size() <= 80 &&
        data.role in ['owner', 'staff'] &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    function isValidAdminDoc(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'created_at']) &&
        data.keys().hasOnly(['uid', 'email', 'created_at']) &&
        data.uid is string && data.uid == adminId && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.created_at is timestamp;
    }

    function isValidMenuItem(data, itemId) {
      return data.keys().hasAll([
          'id', 'name', 'category', 'description', 'price', 'offer_price',
          'image', 'available', 'is_veg', 'featured', 'created_at', 'updated_at'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'category', 'description', 'price', 'offer_price',
          'image', 'available', 'is_veg', 'featured', 'prep_minutes', 'created_at', 'updated_at'
        ]) &&
        data.id is string && data.id == itemId && data.id.size() <= 64 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.category in ['rolls', 'burgers', 'snacks', 'chicken', 'fast_food', 'drinks', 'lassi', 'desserts', 'special'] &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 220 &&
        data.price is number && data.price >= 1 && data.price <= 20000 &&
        data.offer_price is number && (data.offer_price == 0 || (data.offer_price >= 1 && data.offer_price < data.price)) &&
        isSafeImageUrl(data.image) &&
        data.available is bool &&
        data.is_veg is bool &&
        data.featured is bool &&
        (!('prep_minutes' in data) || (data.prep_minutes is number && data.prep_minutes >= 1 && data.prep_minutes <= 120)) &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    function isValidOffer(data, offerId) {
      return data.keys().hasAll([
          'id', 'title', 'description', 'image', 'regular_price', 'offer_price',
          'active', 'created_at', 'updated_at'
        ]) &&
        data.keys().hasOnly([
          'id', 'title', 'description', 'image', 'regular_price', 'offer_price',
          'active', 'created_at', 'updated_at'
        ]) &&
        data.id is string && data.id == offerId && data.id.size() <= 64 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 80 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 200 &&
        isSafeImageUrl(data.image) &&
        data.regular_price is number && data.regular_price >= 2 && data.regular_price <= 20000 &&
        data.offer_price is number && data.offer_price >= 1 && data.offer_price < data.regular_price &&
        data.active is bool &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    function isValidTable(data, tableId) {
      return data.keys().hasAll(['id', 'table_number', 'qr_code', 'status', 'active_order_id', 'updated_at']) &&
        data.keys().hasOnly(['id', 'table_number', 'qr_code', 'status', 'active_order_id', 'updated_at']) &&
        data.id is string && data.id == tableId &&
        data.id in ['table_1', 'table_2', 'table_3', 'table_4', 'table_5', 'table_6'] &&
        data.table_number is int && data.table_number >= 1 && data.table_number <= 6 &&
        data.qr_code is string && data.qr_code.size() >= 1 && data.qr_code.size() <= 300 &&
        data.status in ['available', 'ordering', 'preparing', 'ready', 'bill_requested'] &&
        data.active_order_id is string && data.active_order_id.size() <= 128 &&
        data.updated_at is timestamp;
    }

    function isValidPaymentSettings(data, settingId) {
      return settingId == 'payment' &&
        data.keys().hasAll(['id', 'payment_mode', 'upi_id', 'merchant_name', 'qr_image_url', 'updated_at']) &&
        data.keys().hasOnly(['id', 'payment_mode', 'upi_id', 'merchant_name', 'qr_image_url', 'updated_at']) &&
        data.id is string && data.id == 'payment' &&
        data.payment_mode in ['uploaded_qr', 'dynamic_upi'] &&
        data.upi_id is string && data.upi_id.size() <= 120 &&
        (data.upi_id == '' || data.upi_id.matches('^[a-zA-Z0-9._\\-]{2,80}@[a-zA-Z0-9.\\-]{2,64}$')) &&
        data.merchant_name is string && data.merchant_name.size() >= 2 && data.merchant_name.size() <= 80 &&
        data.qr_image_url is string && data.qr_image_url.size() <= 500 &&
        (data.qr_image_url == '' || isSafeImageUrl(data.qr_image_url)) &&
        data.updated_at is timestamp;
    }

    function isValidOrderLineItem(item) {
      return item is map &&
        item.keys().hasAll(['menu_item_id', 'name', 'regular_price', 'unit_price', 'quantity', 'line_total']) &&
        item.keys().hasOnly(['menu_item_id', 'name', 'regular_price', 'unit_price', 'quantity', 'line_total']) &&
        item.menu_item_id is string && item.menu_item_id.size() >= 1 && item.menu_item_id.size() <= 64 &&
        item.name is string && item.name.size() >= 2 && item.name.size() <= 80 &&
        item.regular_price is number && item.regular_price >= 1 && item.regular_price <= 20000 &&
        item.unit_price is number && item.unit_price >= 1 && item.unit_price <= item.regular_price &&
        item.quantity is int && item.quantity >= 1 && item.quantity <= 20 &&
        item.line_total is number && item.line_total == item.unit_price * item.quantity;
    }

    function isValidOrderMutableFields(data) {
      return data.status in [
          'pending', 'accepted', 'confirmed', 'preparing', 'ready',
          'bill_requested', 'bill_ready', 'completed', 'rejected', 'cancelled'
        ] &&
        (!('payment_status' in data) || data.payment_status in ['not_paid', 'pending', 'verification_requested', 'paid', 'not_received', 'failed']) &&
        (!('paid_at' in data) || (data.paid_at is string && data.paid_at.size() <= 64)) &&
        (!('payment_verified_by' in data) || (data.payment_verified_by is string && data.payment_verified_by.size() <= 128)) &&
        (!('payment_verified_at' in data) || (data.payment_verified_at is string && data.payment_verified_at.size() <= 64)) &&
        (!('confirmed_at' in data) || (data.confirmed_at is string && data.confirmed_at.size() <= 64)) &&
        (!('cancelled_at' in data) || (data.cancelled_at is string && data.cancelled_at.size() <= 64)) &&
        (!('cancelled_by' in data) || (data.cancelled_by is string && data.cancelled_by.size() <= 128)) &&
        (!('upi_uri' in data) || isSafeUpiUri(data.upi_uri)) &&
        (!('public_bill_id' in data) || (data.public_bill_id is string && data.public_bill_id.size() <= 64 && (data.public_bill_id == '' || data.public_bill_id.matches('^[a-zA-Z0-9_\\-]+$')))) &&
        (!('payment_qr_snapshot' in data) || data.payment_qr_snapshot == null || isValidPaymentQrSnapshot(data.payment_qr_snapshot)) &&
        (!('pdf_ready' in data) || data.pdf_ready is bool) &&
        (!('bill_status' in data) || data.bill_status in ['not_generated', 'generating', 'generated', 'sending', 'sent', 'failed', 'retrying']) &&
        (!('pdf_url' in data) || isSafeBillUrl(data.pdf_url)) &&
        (!('pdf_path' in data) || isSafeBillPath(data.pdf_path)) &&
        (!('generated_at' in data) || (data.generated_at is string && data.generated_at.size() <= 64)) &&
        data.updated_at is timestamp;
    }

    function isValidOrder(data, orderId) {
      return data.keys().hasAll([
          'id', 'order_number', 'order_code', 'table_id', 'table_number',
          'customer_name', 'customer_mobile', 'items', 'item_count',
          'subtotal', 'discount', 'total', 'status', 'pdf_ready',
          'customer_session_id', 'server_signature', 'notes', 'created_at', 'updated_at'
        ]) &&
        data.keys().hasOnly([
          'id', 'order_number', 'order_code', 'table_id', 'table_number',
          'customer_name', 'customer_mobile', 'items', 'item_count',
          'subtotal', 'discount', 'total', 'status',
          'payment_status', 'paid_at', 'payment_verified_by', 'payment_verified_at',
          'confirmed_at', 'cancelled_at', 'cancelled_by', 'upi_uri',
          'public_bill_id', 'payment_qr_snapshot',
          'pdf_ready', 'bill_status', 'pdf_url', 'pdf_path', 'generated_at',
          'sent_at', 'send_status', 'whatsapp_status', 'whatsapp_error',
          'customer_session_id', 'server_signature', 'notes', 'created_at', 'updated_at'
        ]) &&
        data.id is string && data.id == orderId &&
        data.order_number is int && data.order_number >= 1000 && data.order_number <= 99999999 &&
        data.order_code is string && data.order_code.size() <= 16 && data.order_code.matches('^RK[0-9]{4,8}$') &&
        data.table_id in ['table_1', 'table_2', 'table_3', 'table_4', 'table_5', 'table_6'] &&
        data.table_number is int && data.table_number >= 1 && data.table_number <= 6 &&
        data.table_id == 'table_' + string(data.table_number) &&
        data.customer_name is string && data.customer_name.size() >= 2 && data.customer_name.size() <= 80 &&
        data.customer_mobile is string && data.customer_mobile.size() <= 16 && data.customer_mobile.matches('^\\+91[6-9][0-9]{9}$') &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 20 &&
        isValidOrderLineItem(data.items[0]) &&
        data.item_count is int && data.item_count >= 1 && data.item_count <= 100 &&
        data.subtotal is number && data.subtotal >= 1 && data.subtotal <= 50000 &&
        data.discount is number && data.discount >= 0 && data.discount < data.subtotal &&
        data.total is number && data.total == data.subtotal - data.discount &&
        isValidOrderMutableFields(data) &&
        (!('sent_at' in data) || (data.sent_at is string && data.sent_at.size() <= 64)) &&
        (!('send_status' in data) || data.send_status in ['not_sent', 'sending', 'retrying', 'sent', 'failed']) &&
        (!('whatsapp_status' in data) || data.whatsapp_status in ['not_sent', 'sending', 'retrying', 'sent', 'failed']) &&
        (!('whatsapp_error' in data) || (data.whatsapp_error is string && data.whatsapp_error.size() <= 240)) &&
        data.customer_session_id is string && data.customer_session_id.size() >= 16 && data.customer_session_id.size() <= 128 &&
        data.customer_session_id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.server_signature is string && data.server_signature.size() >= 32 && data.server_signature.size() <= 128 &&
        data.server_signature.matches('^[a-fA-F0-9]+$') &&
        data.notes is string && data.notes.size() <= 200 &&
        data.created_at is timestamp &&
        data.updated_at is timestamp;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    // Users (Owner/Staff PII strictly isolated)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isSelf(userId) || isOwner());
      allow list: if isOwner();
      allow create: if isValidId(userId) && isOwner() && isValidUser(incoming(), userId) &&
        incoming().created_at == request.time &&
        incoming().updated_at == request.time;
      allow update: if isValidId(userId) && isValidUser(incoming(), userId) && (
        (isOwner() && incoming().uid == existing().uid && incoming().created_at == existing().created_at && incoming().updated_at == request.time) ||
        (isSelf(userId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['display_name', 'updated_at']) &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().role == existing().role &&
          incoming().created_at == existing().created_at &&
          incoming().updated_at == request.time)
      );
      allow delete: if isValidId(userId) && isOwner();
    }

    // Trusted Admin Registry
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner();
      allow list: if isOwner();
      allow create: if isValidId(adminId) && isOwner() && isValidAdminDoc(incoming(), adminId) &&
        incoming().created_at == request.time;
      allow update: if false;
      allow delete: if isValidId(adminId) && isOwner();
    }

    // Public Menu Catalog (Customer READ ONLY; Owner CRUD only)
    match /menu_items/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create: if isValidId(itemId) && isOwner() && isValidMenuItem(incoming(), itemId) &&
        incoming().created_at == request.time &&
        incoming().updated_at == request.time;
      allow update: if isValidId(itemId) && isOwner() && isValidMenuItem(incoming(), itemId) &&
        incoming().id == existing().id &&
        (!('created_at' in existing()) || incoming().created_at == existing().created_at) &&
        incoming().updated_at == request.time;
      allow delete: if isValidId(itemId) && isOwner();
    }

    // Promotional Combo Offers (Customer READ ONLY; Owner CRUD only)
    match /offers/{offerId} {
      allow get: if isValidId(offerId);
      allow list: if true;
      allow create: if isValidId(offerId) && isOwner() && isValidOffer(incoming(), offerId) &&
        incoming().created_at == request.time &&
        incoming().updated_at == request.time;
      allow update: if isValidId(offerId) && isOwner() && isValidOffer(incoming(), offerId) &&
        incoming().id == existing().id &&
        (!('created_at' in existing()) || incoming().created_at == existing().created_at) &&
        incoming().updated_at == request.time;
      allow delete: if isValidId(offerId) && isOwner();
    }

    // Physical Restaurant Tables (6 tables)
    match /tables/{tableId} {
      allow get: if isValidId(tableId) && tableId in ['table_1', 'table_2', 'table_3', 'table_4', 'table_5', 'table_6'];
      allow list: if isOwner();
      allow create: if isValidId(tableId) && isOwner() && isValidTable(incoming(), tableId) &&
        incoming().updated_at == request.time;
      allow update: if isValidId(tableId) && isOwner() && isValidTable(incoming(), tableId) &&
        incoming().id == existing().id &&
        incoming().table_number == existing().table_number &&
        incoming().updated_at == request.time;
      allow delete: if isValidId(tableId) && isOwner();
    }

    // Public Restaurant Payment Settings (Uploaded QR or Dynamic UPI QR — zero secrets)
    match /shop_settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'payment';
      allow list: if isOwner();
      allow create: if isValidId(settingId) && isOwner() && isValidPaymentSettings(incoming(), settingId) &&
        incoming().updated_at == request.time;
      allow update: if isValidId(settingId) && isOwner() && isValidPaymentSettings(incoming(), settingId) &&
        incoming().id == existing().id &&
        incoming().updated_at == request.time;
      allow delete: if false;
    }

    // Real-time Dine-In Orders (Strict Customer Isolation + Verified Totals + Owner Partial Updates)
    match /orders/{orderId} {
      // Only verified shop owner can list all orders. Customers can only read their own order via unguessable ID.
      allow get: if isOwner() || isValidOrderDocId(orderId);
      allow list: if isOwner();

      // Customers create verified pending orders (never pre-marked as paid or confirmed).
      allow create: if isValidOrderDocId(orderId) &&
        isValidOrder(incoming(), orderId) &&
        incoming().status == 'pending' &&
        (!('payment_status' in incoming()) || incoming().payment_status in ['pending', 'not_paid']) &&
        (!('paid_at' in incoming()) || incoming().paid_at == '') &&
        (!('confirmed_at' in incoming()) || incoming().confirmed_at == '') &&
        incoming().created_at == request.time &&
        incoming().updated_at == request.time;

      // Partial-update rule: strictly locks all immutable order fields via affectedKeys().hasOnly(...)
      // while validating every mutable field written by Owner (Tier 1) or Customer Actions (Tier 2).
      allow update: if isValidOrderDocId(orderId) &&
        isValidOrderMutableFields(incoming()) &&
        incoming().updated_at == request.time && (
          // Tier 1: Verified Owner manages lifecycle, confirmation, cancellation, manual payment verification, and bill snapshot
          (isOwner() && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'confirmed_at', 'cancelled_at', 'cancelled_by',
            'payment_status', 'paid_at', 'payment_verified_by', 'payment_verified_at',
            'upi_uri', 'public_bill_id', 'payment_qr_snapshot',
            'pdf_ready', 'bill_status', 'pdf_url', 'pdf_path',
            'generated_at', 'updated_at'
          ])) ||
          // Tier 2a: Dine-in customer can ONLY request bill on an active confirmed/preparing/ready order
          (!(existing().status in ['completed', 'rejected', 'cancelled']) &&
            existing().status in ['accepted', 'confirmed', 'preparing', 'ready'] &&
            incoming().status == 'bill_requested' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updated_at'])) ||
          // Tier 2b: Dine-in customer can ONLY request manual payment verification ("I HAVE PAID") — NEVER mark paid!
          (!(existing().status in ['rejected', 'cancelled']) &&
            (!('payment_status' in existing()) || existing().payment_status != 'paid') &&
            incoming().payment_status == 'verification_requested' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['payment_status', 'updated_at']))
        );

      allow delete: if isValidOrderDocId(orderId) && isOwner();
    }

    // Connection test probe
    match /test/{docId} {
      allow read, write: if false;
    }
  }
}
